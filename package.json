{
  "name": "chato-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "chatO Real-Time Chat App Monorepo",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "npm install --include=dev && npx prisma generate && cd backend && npm install --include=dev && npx prisma generate && cd ../frontend && npm install --include=dev && npm run build",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "cd backend && npm test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1"
  },
  "keywords": [],
  "author": "SAIVENKATESH108",
  "license": "MIT"
}
